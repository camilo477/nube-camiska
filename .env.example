# For the Raspberry, keep CLOUD_STORAGE_DIR=/data and mount your disk at /data.
CLOUD_STORAGE_DIR=./data
PORT=8080
CLOUD_USER=propietario
CLOUD_PASSWORD=cambia-esta-clave
CLOUD_SECURITY_TOKEN=cambia-este-token

# Set this to your EXISTING owner username before the first upgrade.
# It is saved in .accounts-layout.json; do not rename that account casually.
CLOUD_LEGACY_USER=propietario

# Optional: a separate, read-only portfolio demo. No public password is needed.
CLOUD_DEMO_ENABLED=false

# Optional: use this INSTEAD of CLOUD_USER/CLOUD_PASSWORD for multiple accounts.
# Every account has independent files, trash, checksums, shares and rooms.
# CLOUD_USERS_JSON=[{"username":"propietario","password":"...","role":"admin"},{"username":"otra-persona","password":"...","role":"admin"}]
